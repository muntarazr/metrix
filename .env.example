# Copy this file to .env.local and fill in real values.
# Without these, every request 500s in src/proxy.ts before any page renders.

# Supabase project — required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client or log it.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — plan generation, evaluation, daily focus, milestone images
GEMINI_API_KEY=

# Mistral — voice note transcription (/api/transcribe)
MISTRAL_API_KEY=

# ImageKit — server-side image uploads
IMAGEKIT_PRIVATE_KEY=
